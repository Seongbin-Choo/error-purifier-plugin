<idea-plugin>
  <id>com.jcms.errorpurifier.plugin</id>
  <name>AI Error Log Purifier</name>
  <vendor>Error Purifier</vendor>
  <description><![CDATA[
      콘솔 오류 로그와 프로젝트 환경을 정제해, 사용자가 선택한 AI에 바로 보낼 프롬프트를 만드는 IntelliJ 플러그인입니다.<br>
      불필요한 스택 트레이스를 줄이고 재사용 가능한 정제 프로세스를 적용해 AI 토큰 사용량을 낮춥니다.
    ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="AI Error Purifier"
                anchor="right"
                icon="AllIcons.General.Modified"
                factoryClass="com.errorpurifier.ui.ErrorPurifierToolWindowFactory"/>
    <applicationConfigurable parentId="tools"
                             instance="com.errorpurifier.service.ErrorPurifierConfigurable"
                             displayName="AI Error Purifier"/>
  </extensions>
  <actions>
    <action id="PurifyErrorLogAction"
            class="com.errorpurifier.action.PurifyErrorLogAction"
            text="에러 로그 AI 분석 (비용 최적화)"
            description="선택한 에러 로그를 정제하여 AI에게 분석을 요청합니다.">
      <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
